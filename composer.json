{
    "name": "vicam/vicam-kit",
    "description": "Reusable Laravel + Inertia + Vue starter kit with AI guidelines and tooling",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0",
        "laravel/prompts": "^0.3"
    },
    "autoload": {
        "psr-4": {
            "Vicam\\VicamKit\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vicam\\VicamKit\\VicamKitServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
